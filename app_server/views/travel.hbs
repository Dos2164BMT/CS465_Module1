<div id="contents">
  <div class="box">
    <div>
      <div class="body">
        <h1>Travel</h1>
        <ul id="sites">
          {{#each trips}}
            <li data-trip-code="{{code}}">
              <a href="/api/trips/{{code}}"><img src="/images/{{image}}" alt="{{name}}"></a>
              <h2><a href="/travel">{{name}}</a></h2>
              <p>{{description}}</p>
              <p>
                <strong>{{length}}</strong><br>
                {{start}} &bull; {{resort}}<br>
                From ${{perPerson}} per person
              </p>
            </li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>
</div>
